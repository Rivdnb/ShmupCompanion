@page "/games/{GameId:int}/runs/{runId:int}/notes/{Id:int}/test"
@using ShmupCompanion.Contracts
@using ShmupCompanion.Web.Services
@inject GameApiService GameApiService
@inject RunApiService RunApiService
@inject NoteApiService NoteApiService
@inject NavigationManager Navigation

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <h1>@note!.Name</h1>
    <div>
        <BitRichTextEditor @bind-Value="updateNote.Text" OnImageUpload="HandleImageUpload"
                           OnChange="OnChangeSave" DebounceMs="1500"/>
    </div>
}

@if (lastUpload != null)
{
    <div>Last upload: <b>@lastUpload</b></div>
}

@code {
    [Parameter]
    public int Id { get; set; }
    [Parameter]
    public int GameId { get; set; }
    [Parameter]
    public int RunId { get; set; }
    private NoteDto? note;
    private bool isLoading = true;
    private NoteRequest updateNote = new NoteRequest();
    private string? lastUpload;
    private string? lastSavedContent;
    private bool isSaving = false;
    private bool isDirty = false;


    protected override void OnParametersSet()
    {
        Id = Id;
        GameId = GameId;
        RunId = RunId;
    } 

    protected override async Task OnInitializedAsync()
    {
        note = await NoteApiService.GetAsync(GameId, RunId, Id);
        if (note == null)
        {
            Navigation.NavigateTo("/not-found");
            return;
        }
        updateNote.Name = note.Name;
        updateNote.Text = note.Text;
        isLoading = false;
        lastSavedContent = updateNote.Text;
    }

    private async Task OnChangeSave() // auto save (TODO)
    {
        if (updateNote.Text == lastSavedContent) return;
        await NoteApiService.UpdateAsync(updateNote, GameId, RunId, Id);
        lastSavedContent = updateNote.Text;
    }

    private async Task DeleteGame()
    {
        await NoteApiService.DeleteAsync(GameId, RunId, Id);
        Navigation.NavigateTo($"/games/{GameId}/runs/{RunId}");
    }

    private async Task<string?> HandleImageUpload(BitRichTextEditorImageUpload image)
    {
        lastUpload = $"{image.FileName} ({image.ContentType}, {image.Content.Length:N0} bytes)";
        return await NoteApiService.UploadImageAsync(GameId, RunId, Id, image);
    }

}