@page "/games/{GameId:int}/runs/{runId:int}/notes/{Id:int}"
@using ShmupCompanion.Contracts
@using ShmupCompanion.Web.Services
@inject GameApiService GameApiService
@inject RunApiService RunApiService
@inject NoteApiService NoteApiService
@inject NavigationManager Navigation

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <h1>@note!.Name</h1>

    <h2>Note</h2>
    <EditForm Model=@updateNote OnValidSubmit=@HandleSubmit>
        <DataAnnotationsValidator />
        <div>
            <InputText @bind-Value="updateNote.Name" placeholder=@($"{note.Name}") />
            <ValidationMessage For="@(() => updateNote.Name)" />
        </div>
        <div>
            <InputText @bind-Value="updateNote.Text" style="width: 300px; height: 40px;" />
            <ValidationMessage For="@(() => updateNote.Text)" />
        </div>

        <button type="submit">Save Changes</button>
    </EditForm>

    <h2>Delete note</h2>
    <p>
        <button @onclick="DeleteGame">
            Delete
        </button>
    </p>
}

@code {
    [Parameter]
    public int Id { get; set; }
    [Parameter]
    public int GameId { get; set; }
    [Parameter]
    public int RunId { get; set; }
    private NoteDto? note;
    private bool isLoading = true;
    private NoteRequest updateNote = new NoteRequest();


    protected override void OnParametersSet()
    {
        Id = Id;
        GameId = GameId;
        RunId = RunId;
    } 

    protected override async Task OnInitializedAsync()
    {
        note = await NoteApiService.GetAsync(GameId, RunId, Id);
        if (note == null)
        {
            Navigation.NavigateTo("/not-found");
            return;
        }
        updateNote.Name = note.Name;
        updateNote.Text = note.Text;
        isLoading = false;
    }

    private async Task HandleSubmit()
    {
        await NoteApiService.UpdateAsync(updateNote, GameId, RunId, Id);
        Navigation.NavigateTo($"games/{GameId}/runs/{RunId}/notes/{Id}", true);
    }

    private async Task DeleteGame()
    {
        await NoteApiService.DeleteAsync(GameId, RunId, Id);
        Navigation.NavigateTo($"/games/{GameId}/runs/{RunId}");
    }

}