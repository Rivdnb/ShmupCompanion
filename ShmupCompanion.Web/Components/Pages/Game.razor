@page "/games/{Id:int}"
@using ShmupCompanion.Contracts
@using ShmupCompanion.Web.Services
@inject GameApiService GameApiService
@inject RunApiService RunApiService
@inject NavigationManager Navigation

@if (isLoading)
{
    <p>Loading...</p>
}
else
{
    <h1>@game!.Name (@game.ReleaseYear), developed by @game.Developer</h1>

    <h2>Your Runs</h2>
    @foreach (var run in runs)
    {
        <p>
            <NavLink href="@($"games/{game.Id}/runs/{run.Id}")">@run.Name</NavLink>
        </p>
    }
    <h3>Create Run</h3>
    <EditForm Model=@newRun OnValidSubmit=@HandleSubmitRun>
        <DataAnnotationsValidator />
        <div>
            <label>Name</label>
            <InputText @bind-Value="newRun.Name" placeholder="My first 1CC" />
            <ValidationMessage For="@(() => newRun.Name)" />
        </div>

        <button type="submit">Submit</button>
    </EditForm>

    <h2>Update game</h2>
    <EditForm Model=@updateGame OnValidSubmit=@HandleSubmitGame>
        <DataAnnotationsValidator />
        <div>
            <label>Name</label>
            <InputText @bind-Value="updateGame.Name" placeholder=@($"{game.Name}")/>
            <ValidationMessage For="@(() => updateGame.Name)" />
        </div>

        <div>
            <label>Developer</label>
            <InputText @bind-Value="updateGame.Developer" placeholder=@($"{game.Developer}") />
            <ValidationMessage For="@(() => updateGame.Developer)" />
        </div>

        <div>
            <label>Release year</label>
            <InputNumber @bind-Value="updateGame.ReleaseYear" />
            <ValidationMessage For="@(() => updateGame.ReleaseYear)" />
        </div>

        <button type="submit">Submit</button>
    </EditForm>

    <h2>Delete game</h2>
    <p>
        <button @onclick="DeleteGame">
            Delete
        </button>
    </p>
}

@code {
    [Parameter]
    public int Id { get; set; }
    private GameDto? game;
    private List<RunDto> runs = [];
    private bool isLoading = true;
    private RunRequest newRun = new RunRequest();
    private GameRequest updateGame = new GameRequest();

    protected override void OnParametersSet() => Id = Id;

    protected override async Task OnInitializedAsync()
    {
        game = await GameApiService.GetAsync(Id);
        if(game == null)
        {
            Navigation.NavigateTo("/not-found");
            return;
        }
        runs = await RunApiService.GetAllForGameAsync(game.Id);
        updateGame.ReleaseYear = game.ReleaseYear; // for correctly showcasing the placeholder value instead of 0
        isLoading = false;

    }

    private async Task HandleSubmitRun()
    {
        RunDto? run = await RunApiService.PostAsync(newRun, Id);
        Navigation.NavigateTo($"games/{Id}", true);
    }

    private async Task HandleSubmitGame()
    {
        await GameApiService.UpdateAsync(updateGame, Id);
        Navigation.NavigateTo($"games/{Id}", true);
    }

    private async Task DeleteGame()
    {
        await GameApiService.DeleteAsync(Id);
        Navigation.NavigateTo("/games");
    }

}